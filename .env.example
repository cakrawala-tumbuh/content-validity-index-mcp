# content-validity-index-mcp — contoh konfigurasi (POLA B).
# Salin menjadi .env dan isi nilainya. JANGAN commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=content-validity-index-mcp
MCP_LOG_LEVEL=INFO

# Transport saat `python -m content_validity_index_mcp` (stdio | http | sse).
# Untuk Docker/cloud, uvicorn memakai content_validity_index_mcp.asgi:app.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# ── Backend yang dilayani ─────────────────────────────────────────────────────
# Base URL content-validity-index-backend (tanpa /api/v1).
BACKEND_API_BASE_URL=https://cvi-api.example.com
# Token Authentik statis untuk pemakaian stdio/lokal (Claude Desktop). Kosongkan
# untuk deployment HTTP — token user diteruskan dari header Authorization.
BACKEND_API_TOKEN=

# ── OAuth via Authentik (WAJIB untuk Claude Web / claude.ai) ──────────────────
# URL publik MCP server ini (untuk redirect OAuth). Contoh: https://mcp.example.com
MCP_BASE_URL=

# POLA B: issuer HARUS SAMA dengan AUTHENTIK_ISSUER_URL di backend.
# Contoh: https://auth.example.com/application/o/cvi/
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Nama group untuk role — samakan dengan backend.
AUTHENTIK_ADMIN_GROUP=cvi-admin
AUTHENTIK_EXPERT_GROUP=cvi-expert

# ── API Key (klien non-OAuth: VS Code / CLI) ──────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Kosongkan untuk menonaktifkan (lokal/stdio).
MCP_API_KEY=
